\name{latent-data}
\alias{ESS_datLCA}
\alias{hs_academic}
\alias{icases}
\alias{mtmm}
\docType{data}
\title{Example data for latent variable models}
\description{Survey responses, school achievement, personality items, and sample moments for latent variable analyses.}
\format{\describe{
\item{\code{ESS_datLCA}}{A data frame of 18,060 European Social Survey respondents,
with eight political participation indicators, gender, age, and country.}
\item{\code{hs_academic}}{A data frame of 500 students with four binary school
history indicators and achievement scores for grades 9 through 12.}
\item{\code{icases}}{A data frame of 28,143 respondents with 136 variables
from the five HEXACO samples. The sample identifier is a character vector.}
\item{\code{mtmm}}{A list of sample sizes, means, standard deviations,
correlations, and covariances for ABCD, HBN, NICHD Grade 6, and NICHD age 15.}
}}
\keyword{datasets}
